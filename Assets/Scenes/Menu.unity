  m_text: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435:\n\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u043C \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
    \u043A\u043B\u0430\u0432\u0438\u0448 WASD.\n\n\u0410\u0442\u0430\u043A\u0443\u0439\u0442\u0435
    \u0432\u0440\u0430\u0433\u043E\u0432, \u043A\u043B\u0438\u043A\u0430\u044F \u041B\u0435\u0432\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u0438.\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    M, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C
    \u043A\u0430\u0440\u0442\u0443 \u043C\u0438\u0440\u0430.\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    ESC \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0431\u043E\u044F \u0434\u043B\u044F
    \u043F\u0430\u0443\u0437\u044B.\n\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438:
    \u0421\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u0433\u0440\u0443\u043F\u043F\u044B
    [\u0418\u0421\u0438\u041F-24\u0414\u041E]"
