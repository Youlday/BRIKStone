      m_Calls: []
  m_text: "\u041E\u0411 \u0418\u0413\u0420\u0415: \n\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435:
    BRIKSTONE \n\u0416\u0430\u043D\u0440: \u041F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\n\u0426\u0415\u041B\u042C
    \u0418\u0413\u0420\u042B: \u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439\u0442\u0435
    \u0444\u044D\u043D\u0442\u0435\u0437\u0438\u0439\u043D\u044B\u0439 \u043C\u0438\u0440,
    \u0441\u0440\u0430\u0436\u0430\u0439\u0442\u0435\u0441\u044C \u0441\u043E \u0441\u043B\u0430\u0439\u043C\u0430\u043C\u0438
    \u0438 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C\u0438,
    \u043E\u0447\u0438\u0449\u0430\u0439\u0442\u0435 \u043B\u043E\u043A\u0430\u0446\u0438\u0438
    \u0438 \u0432\u044B\u0436\u0438\u0432\u0430\u0439\u0442\u0435, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
    \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E
    \u0438 \u043A\u0430\u0440\u0442\u0443 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438."
  m_isRightToLeft: 0
